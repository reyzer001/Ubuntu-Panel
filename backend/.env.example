# Ubuntu Panel - backend configuration
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/ubuntu_panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# "*" mengizinkan semua origin (localhost, LAN, Tailscale).
# Contoh membatasi: CORS_ORIGINS=["http://100.96.226.106:3000","http://localhost:3000"]
CORS_ORIGINS=["*"]
# Akses publik panel lewat zrok2 (toggle superadmin di dashboard).
# FRONTEND_PORT diteruskan otomatis oleh panel.sh.
ZROK_BIN=zrok2
ZROK_SHARE_NAMESPACE=public
ZROK_SHARE_NAME=ubuntu-panel
# ZROK_SHARE_URL=https://ubuntu-panel.shares.zrok.io
# Offset tanggal tabel Report dari UTC (7 = WIB).
REPORT_UTC_OFFSET_HOURS=7
# Pangkas log .run/logs dan backend/data/weblogs jika melebihi batas.
CLEANUP_LOG_MAX_BYTES=26214400
CLEANUP_LOG_KEEP_BYTES=2097152
